    {
      "id": "4JPSRQ4KDSVcXSpQWWjsx",
      "type": "text",
      "x": 55.3045671107152,
      "y": -458.645461635003,
      "width": 1055.19921875,
      "height": 650,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2AV",
