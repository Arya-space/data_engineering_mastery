    {
      "id": "KgZ8uTX_ARkW-OYV-MY55",
      "type": "text",
      "x": 150.86160899103118,
      "y": 2111.2884458490435,
      "width": 567.0396728515625,
      "height": 925,
      "angle": 0,
      "strokeColor": "#1e1e1e",
