      "updated": 1782073283406,
      "link": null,
      "locked": false,
      "text": "sample query \n2 most popular book \n\n\nwhich book  borrowed the most \nselect f.book_id, d.name count(* )as borrowed books \nfrom fact_transctions f join dim_books  d \n\nON f.book_id=d.id\nGroup by f.book_id, d.book_name \norderby  borrowed_books \nlimit 1;\n\n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "4i7DRRK-9z26i8vZKHW1f",
      "originalText": "sample query \n2 most popular book \n\n\nwhich book  borrowed the most \nselect f.book_id, d.name count(* )as borrowed books \nfrom fact_transctions f join dim_books  d \n\nON f.book_id=d.id\nGroup by f.book_id, d.book_name \norderby  borrowed_books \nlimit 1;\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ANonTePj0YglvkMW2pVyZ",
