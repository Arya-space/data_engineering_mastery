      "link": null,
      "locked": false,
      "text": "Q1 how would you scale this : Scaling ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Pm4if_puyEvUiW0RbpKdN",
      "originalText": "Q1 how would you scale this : Scaling ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8jKBkQv3-dRLJhnrpFj4V",
      "type": "rectangle",
      "x": -878.643825373644,
      "y": 2077.2525596913692,
      "width": 986.0488047646621,
      "height": 1160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b23",
      "roundness": {
        "type": 3
      },
      "seed": 163632913,
      "version": 267,
      "versionNonce": 529446243,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
          "id": "zxQmctJhiwUTgKAJ6B950"
        }
      ],
