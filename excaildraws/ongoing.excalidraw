    {
      "id": "-HeFzEkfq0jugf_5uKTy2",
      "type": "text",
      "x": -684.7809867854605,
      "y": 6587.696659047177,
      "width": 785.2593383789062,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
