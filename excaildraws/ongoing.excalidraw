      "text": "Q4 what are best\npractices in pyspark ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "nrUMxPkALIkoY0q2INi96",
      "originalText": "Q4 what are best practices in pyspark ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dWp1-P8wF7LiibdtBjjwu",
      "type": "rectangle",
      "x": -691.4475876441376,
      "y": 9593.567737624086,
      "width": 448.0250430949153,
      "height": 1045,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
