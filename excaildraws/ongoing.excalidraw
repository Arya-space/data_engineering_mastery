    {
      "id": "_beMmJ3FhwD0SSAQSNd0G",
      "type": "text",
      "x": -716.0320572824262,
      "y": 10799.635615254134,
      "width": 411.4798889160156,
      "height": 945,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
