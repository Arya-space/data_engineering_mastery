    {
      "id": "eEN2jUzEVK-Kg4DheRZpx",
      "type": "text",
      "x": -148.87231500616656,
      "y": 4911.340181440446,
      "width": 1144.419189453125,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
