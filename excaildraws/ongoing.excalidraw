    },
    {
      "id": "-r0dscG5f0NEczskoQbiP",
      "type": "text",
      "x": -676.8289869951175,
      "y": 9598.567737624086,
      "width": 418.787841796875,
      "height": 1035,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7V",
      "roundness": null,
      "seed": 258679106,
      "version": 385,
      "versionNonce": 1822415070,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782251346513,
      "link": null,
      "locked": false,
      "text": "The best practices in\nPySpark include using\nDataFrames instead of\nRDDs because they\nleverage Catalyst\noptimizer for automatic\nquery optimization. You\nshould use broadcast\njoins when joining large\ntables with smaller ones\nto avoid expensive\nshuffles. Additionally,\npartition your data\nstrategically and cache\nDataFrames when\nreusing them multiple\ntimes. Overall, the goal\nis to minimize shuffles\nand maximize\noptimization\nopportunities, which\nimproves performance\nsignificantly.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "dWp1-P8wF7LiibdtBjjwu",
      "originalText": "The best practices in PySpark include using DataFrames instead of RDDs because they leverage Catalyst optimizer for automatic query optimization. You should use broadcast joins when joining large tables with smaller ones to avoid expensive shuffles. Additionally, partition your data strategically and cache DataFrames when reusing them multiple times. Overall, the goal is to minimize shuffles and maximize optimization opportunities, which improves performance significantly.",
      "autoResize": true,
      "lineHeight": 1.25
    },
